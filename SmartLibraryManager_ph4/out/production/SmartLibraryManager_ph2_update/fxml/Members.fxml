<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import java.lang.*?>
<?import java.net.*?>
<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="604.0" prefWidth="860.0" spacing="16" styleClass="app-root" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MembersController">

    <!-- CSS الموحد -->
    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <children>
        <!-- العنوان -->
        <Label styleClass="title" text="Members" />
        <HBox alignment="CENTER" prefHeight="347.0" prefWidth="860.0">
            <children>
                <VBox prefHeight="347.0" prefWidth="757.0">
                    <children>
                        <!-- الجدول بتنسيق مرتفع -->
                        <TableView fx:id="membersTable" prefHeight="347.0" prefWidth="84.0" styleClass="table-elevated">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="225.0" text="ID" />
                                <TableColumn fx:id="colName" prefWidth="275.0" text="Name" />
                            </columns>
                        </TableView>
                    </children>
               <padding>
                  <Insets left="20.0" />
               </padding>
                </VBox>
                <VBox alignment="CENTER" prefHeight="347.0" prefWidth="539.0" spacing="50.0">
                    <children>
                        <TextField fx:id="searchTextField" maxHeight="-Infinity" maxWidth="-Infinity" promptText="search by name" />
                        <!-- ComboBox للفرز: تسمية واضحة -->
                        <ComboBox fx:id="searchComboBox" onAction="#searchComboBoxHandler" prefWidth="150.0" promptText="Sort by" style="-fx-background-color: #eee;" />
                        <Button fx:id="searchButton" mnemonicParsing="false" onAction="#searchButtonHandler" prefHeight="36.0" prefWidth="91.0" style="-fx-background-color: #ccc;" text="search" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- نموذج الإدخال أسفل الجدول -->
        <GridPane hgap="12" styleClass="form" vgap="12">
            <columnConstraints>
                <ColumnConstraints minWidth="100.0" />
                <ColumnConstraints hgrow="ALWAYS" maxWidth="491.0" minWidth="386.0" prefWidth="491.0" />
                <ColumnConstraints maxWidth="111.0" minWidth="0.0" prefWidth="0.0" />
                <ColumnConstraints hgrow="ALWAYS" maxWidth="203.0" minWidth="98.0" prefWidth="199.0" />
            </columnConstraints>
            <children>
                <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="nameField" promptText="e.g. Ahmed Amer" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            </children>
            <rowConstraints>
                <RowConstraints />
            </rowConstraints>
        </GridPane>

        <!-- الأزرار -->
        <HBox styleClass="actions">
            <children>
                <Button onAction="#handleAddMember" styleClass="btn btn-primary" text="Add" />
                <Button onAction="#handleEditMember" styleClass="btn btn-warning" text="Edit Selected" />
                <Separator orientation="VERTICAL" />
                <Button onAction="#handleBack" styleClass="btn btn-secondary" text="Back" />
            </children>
        </HBox>
    </children>
</VBox>
