<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.MembersController"
      alignment="CENTER" prefHeight="640.0" prefWidth="900.0"
      spacing="16" styleClass="app-root">

    <!-- CSS -->
    <stylesheets>
        <URL value="@../css/style.css"/>
    </stylesheets>

    <children>
        <!-- شريط علوي -->
        <ToolBar>
            <items>
                <Label text="Members" styleClass="title"/>
                <Pane/>
                <Label fx:id="statusLabel" text="Ready" styleClass="muted"/>
                <ProgressIndicator fx:id="progress" visible="false" prefWidth="20" prefHeight="20"/>
                <Button fx:id="btnRefresh" text="Refresh" onAction="#doReload"/>
                <Button fx:id="btnCancel"  text="Cancel"  onAction="#handleCancelTask"/>
            </items>
        </ToolBar>

        <HBox spacing="12" alignment="CENTER">
            <children>

                <!-- الجدول -->
                <VBox prefWidth="700.0" styleClass="content-card">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <children>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Results" styleClass="menu-title"/>
                            <Pane HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblCount" styleClass="muted" text="0 members"/>
                        </HBox>

                        <TableView fx:id="membersTable" prefHeight="360.0" styleClass="table-elevated">
                            <columns>
                                <TableColumn fx:id="colId"      prefWidth="90.0"  text="ID"/>
                                <TableColumn fx:id="colName"    prefWidth="240.0" text="Name"/>
                                <TableColumn fx:id="colContact" prefWidth="260.0" text="Contact"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>

                <!-- لوحة البحث -->
                <VBox alignment="CENTER" prefWidth="280.0" spacing="10" styleClass="form-card">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <children>
                        <TextField fx:id="searchTextField" promptText="Search (name/contact)"/>
                        <ComboBox fx:id="searchComboBox" onAction="#searchComboBoxHandler"
                                  prefWidth="180.0" promptText="Sort by"/>
                        <Button fx:id="searchButton" onAction="#searchButtonHandler"
                                prefHeight="36.0" prefWidth="120.0" text="Search"/>
                    </children>
                </VBox>

            </children>
        </HBox>

        <!-- نموذج الإدخال أسفل الجدول -->
        <GridPane hgap="12" vgap="12" styleClass="form-card">
            <columnConstraints>
                <ColumnConstraints minWidth="100.0"/>
                <ColumnConstraints hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="100.0"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <rowConstraints>
                <RowConstraints/>
                <RowConstraints/>
            </rowConstraints>

            <children>
                <Label text="Name:"             GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="nameField"    GridPane.columnIndex="1" GridPane.rowIndex="0"
                           promptText="e.g. Ahmed Amer"/>

                <Label text="Contact:"          GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <TextField fx:id="contactField" GridPane.columnIndex="3" GridPane.rowIndex="0"
                           promptText="e.g. 970XXXXXXX / email@example.com"/>
            </children>
        </GridPane>

        <!-- الأزرار -->
        <HBox styleClass="actions" spacing="12">
            <children>
                <Button onAction="#handleAddMember"    styleClass="btn btn-primary"  text="Add"             prefWidth="140"/>
                <Button onAction="#handleEditMember"   styleClass="btn btn-warning"  text="Edit Selected"   prefWidth="140"/>
                <Button onAction="#handleDeleteMember" styleClass="btn btn-danger"   text="Delete Selected" prefWidth="140"/>
                <Separator orientation="VERTICAL"/>
                <Button onAction="#handleBack"         styleClass="btn btn-secondary" text="Back"           prefWidth="120"/>
            </children>
        </HBox>
    </children>

    <padding>
        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
    </padding>
</VBox>
