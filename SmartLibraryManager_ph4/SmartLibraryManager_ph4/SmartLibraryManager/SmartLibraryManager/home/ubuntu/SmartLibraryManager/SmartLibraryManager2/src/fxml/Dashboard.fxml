<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.DashboardController"
            prefWidth="900" prefHeight="700"
            styleClass="app-root">

    <stylesheets>
        <URL value="@../css/style.css"/>
    </stylesheets>

    <!-- Header -->
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="topbar">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <children>
                <Label text="Smart Library — Dashboard" styleClass="title"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <!-- عناصر الحالة اختيارية -->
                <Label fx:id="lblStatus" text="Ready" styleClass="muted"/>
                <ProgressIndicator fx:id="piLoading" visible="false" prefWidth="20" prefHeight="20"/>

                <Button text="Refresh" onAction="#handleRefresh" styleClass="btn btn-secondary"/>
                <Button text="Sign Out" onAction="#handleSignOut" styleClass="btn btn-danger"/>
            </children>
        </HBox>
    </top>

    <!-- Center content -->
    <center>
        <VBox spacing="18">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Stats -->
            <VBox spacing="10" styleClass="content-card">
                <children>
                    <Label text="Library Statistics" styleClass="menu-title"/>
                    <HBox spacing="12">
                        <children>
                            <VBox styleClass="stat-card">
                                <Label text="Total Books" styleClass="stat-label"/>
                                <Label fx:id="lblBooksTotal" text="0" styleClass="stat-value"/>
                            </VBox>

                            <VBox styleClass="stat-card">
                                <Label text="Available" styleClass="stat-label"/>
                                <Label fx:id="lblBooksAvailable" text="0" styleClass="stat-value"/>
                            </VBox>

                            <VBox styleClass="stat-card">
                                <Label text="Members" styleClass="stat-label"/>
                                <Label fx:id="lblMembers" text="0" styleClass="stat-value"/>
                            </VBox>

                            <VBox styleClass="stat-card">
                                <Label text="Active Borrowings" styleClass="stat-label"/>
                                <Label fx:id="lblBorrowingsActive" text="0" styleClass="stat-value"/>
                            </VBox>
                        </children>
                    </HBox>
                </children>
            </VBox>

            <!-- Quick Actions -->
            <VBox spacing="10" styleClass="content-card">
                <children>
                    <Label text="Quick Actions" styleClass="menu-title"/>
                    <GridPane hgap="14" vgap="14">
                        <columnConstraints>
                            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS"/>
                            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <children>
                            <VBox GridPane.rowIndex="0" GridPane.columnIndex="0"
                                  spacing="8" styleClass="form-card">
                                <Label text="Manage Books" styleClass="brand"/>
                                <Label text="Add, edit, and organize your book inventory" styleClass="muted"/>
                                <Button text="Go to Books" styleClass="menu-btn"
                                        onAction="#handleBooks"/>
                            </VBox>

                            <VBox GridPane.rowIndex="0" GridPane.columnIndex="1"
                                  spacing="8" styleClass="form-card">
                                <Label text="Manage Members" styleClass="brand"/>
                                <Label text="Register and manage library members" styleClass="muted"/>
                                <Button text="Go to Members" styleClass="menu-btn"
                                        onAction="#handleMembers"/>
                            </VBox>

                            <VBox GridPane.rowIndex="1" GridPane.columnIndex="0"
                                  spacing="8" styleClass="form-card">
                                <Label text="Manage Borrowing" styleClass="brand"/>
                                <Label text="Track book borrowings and returns" styleClass="muted"/>
                                <Button text="Go to Borrowing" styleClass="menu-btn"
                                        onAction="#handleBorrowing"/>
                            </VBox>

                            <VBox GridPane.rowIndex="1" GridPane.columnIndex="1"
                                  spacing="8" styleClass="form-card">
                                <Label text="Manage Reports" styleClass="brand"/>
                                <!-- & لازم تكون &amp; -->
                                <Label text="View reminders &amp; calculate fines" styleClass="muted"/>
                                <Button text="Go to Reports" styleClass="menu-btn"
                                        onAction="#handleReports"/>
                            </VBox>
                        </children>
                    </GridPane>
                </children>
            </VBox>

        </VBox>
    </center>

</BorderPane>
