<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.BorrowingController"
      alignment="CENTER" prefHeight="751.0" prefWidth="902.0"
      spacing="16" styleClass="app-root">

    <!-- Styles -->
    <stylesheets>
        <URL value="@../css/style.css"/>
    </stylesheets>

    <children>

        <!-- Topbar مثل الصفحات الأخرى -->
        <ToolBar>
            <items>
                <Label text="Borrowing" styleClass="title"/>
                <Pane/>
                <Label fx:id="statusLabel" text="Ready" styleClass="muted"/>
                <ProgressIndicator fx:id="progress" visible="false" prefWidth="20" prefHeight="20"/>
                <Button text="Refresh" onAction="#handleRefresh"/>
                <Button fx:id="btnCancel" text="Cancel" onAction="#handleCancelTask"/>
            </items>
        </ToolBar>

        <!-- نموذج الإدخال -->
        <GridPane hgap="12" vgap="12" styleClass="form sl-card pad">
            <columnConstraints>
                <ColumnConstraints minWidth="120"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints/>
                <RowConstraints/>
                <RowConstraints/>
            </rowConstraints>
            <children>
                <Label text="Book:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="bookBox" promptText="Select a book"
                          GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Member:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="memberBox" promptText="Select a member"
                          GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Borrow Date:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <DatePicker fx:id="borrowDate"
                            GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </children>
        </GridPane>

        <!-- أزرار الإجراءات الرئيسية -->
        <HBox spacing="12" styleClass="actions sl-card pad">
            <children>
                <Button text="Borrow"           onAction="#handleBorrowBook"      styleClass="btn btn-primary"/>
                <Button text="Return Selected"  onAction="#handleReturnBook"      styleClass="btn btn-accent"/>
                <Button text="Delete Selected"  onAction="#handleDeleteBorrowing" styleClass="btn btn-danger"/>
                <Separator orientation="VERTICAL"/>
                <Button text="Back"             onAction="#handleBack"            styleClass="btn btn-ghost"/>
            </children>
        </HBox>

        <!-- الجدول + البحث -->
        <VBox prefHeight="409.0" prefWidth="868.0" spacing="12">
            <children>

                <HBox alignment="CENTER" spacing="12">
                    <children>

                        <!-- الجدول -->
                        <VBox prefHeight="360.0" prefWidth="761.0" styleClass="sl-card pad">
                            <children>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="Results" styleClass="menu-title"/>
                                    <Pane HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="lblCount" styleClass="muted" text="0 records"/>
                                </HBox>

                                <TableView fx:id="borrowsTable" prefHeight="360.0" styleClass="table-elevated">
                                    <columns>
                                        <TableColumn fx:id="colId"         prefWidth="96.0"  text="ID"/>
                                        <TableColumn fx:id="colBook"       prefWidth="180.0" text="Book"/>
                                        <TableColumn fx:id="colMember"     prefWidth="180.0" text="Member"/>
                                        <TableColumn fx:id="colBorrowDate" prefWidth="120.0" text="Borrow Date"/>
                                        <TableColumn fx:id="colReturnDate" prefWidth="120.0" text="Return Date"/>
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>

                        <!-- لوحة البحث -->
                        <VBox alignment="CENTER" prefWidth="280.0" spacing="10" styleClass="sl-card pad">
                            <children>
                                <TextField fx:id="searchTextField" alignment="CENTER"
                                           prefHeight="41.0" prefWidth="220.0"
                                           promptText="Member or Book title">
                                    <font>
                                        <Font size="16.0"/>
                                    </font>
                                </TextField>
                                <DatePicker fx:id="searchDatePicker" prefHeight="41.0" prefWidth="180.0" promptText="Borrowing date"/>
                                <ComboBox fx:id="searchComboBox" onAction="#searchComboBoxHandler"
                                          prefHeight="33.0" prefWidth="160.0" promptText="Sort by"/>
                                <Button fx:id="searchButton" text="Search" onAction="#searchButtonHandler"
                                        prefHeight="36.0" prefWidth="120.0" styleClass="btn-primary">
                                    <font>
                                        <Font name="System Bold" size="16.0"/>
                                    </font>
                                </Button>
                            </children>
                        </VBox>

                    </children>
                </HBox>

            </children>
        </VBox>

    </children>

    <padding>
        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
    </padding>
</VBox>
