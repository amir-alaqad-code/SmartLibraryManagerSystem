<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.BooksController"
      alignment="TOP_CENTER" prefHeight="628.0" prefWidth="1012.0"
      spacing="16" styleClass="screen">

  <stylesheets>
      <URL value="@../css/style.css"/>
  </stylesheets>

  <children>

    <Label styleClass="title" text="Books" />

    <!-- شريط أدوات: تحديث/إلغاء + حالة التنفيذ -->
    <ToolBar>
      <items>
        <Button fx:id="btnRefresh" text="Refresh" onAction="#doReload"/>
        <Button fx:id="btnCancel"  text="Cancel"  onAction="#handleCancelTask"/>
        <Separator orientation="VERTICAL"/>
        <ProgressIndicator fx:id="progress" visible="false" prefWidth="20" prefHeight="20"/>
        <Label fx:id="statusLabel" text="Ready"/>
      </items>
    </ToolBar>

    <HBox alignment="CENTER" spacing="12">
      <children>

        <!-- جدول الكتب -->
        <VBox prefHeight="315.0" prefWidth="720.0" styleClass="content-card">
          <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
          <children>
            <HBox spacing="8" alignment="CENTER_LEFT">
              <Label text="Results" styleClass="menu-title"/>
              <Pane HBox.hgrow="ALWAYS"/>
              <Label fx:id="lblCount" styleClass="muted" text="0 books"/>
            </HBox>

            <TableView fx:id="booksTable" prefHeight="315.0" styleClass="table-elevated">
              <columns>
                <TableColumn fx:id="colId"     prefWidth="90.0"  text="ID"/>
                <TableColumn fx:id="colTitle"  prefWidth="220.0" text="Title"/>
                <TableColumn fx:id="colAuthor" prefWidth="180.0" text="Author"/>
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status"/>
              </columns>
            </TableView>
          </children>
        </VBox>

        <!-- لوحة البحث/الفلترة (بدون تاريخ) -->
        <VBox alignment="CENTER" spacing="10" prefWidth="280.0" styleClass="form-card">
          <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
          <children>
            <TextField fx:id="searchTextField" promptText="Search (Title/Author)"/>
            <ComboBox fx:id="cbFilterStatus" prefWidth="200.0" promptText="Status"/>
            <!-- تم حذف التاريخ -->
            <Button fx:id="searchButton" onAction="#searchButtonHandler"
                    prefHeight="36.0" prefWidth="100.0" text="Apply"/>
            <Separator/>
            <Label text="Sort by"/>
            <ComboBox fx:id="searchComboBox" onAction="#searchComboBoxHandler"
                      prefHeight="31.0" prefWidth="196.0" promptText="Title/Author"/>
          </children>
        </VBox>

      </children>
    </HBox>

    <!-- بطاقة النموذج (إضافة/تعديل) -->
    <GridPane hgap="12" vgap="12" styleClass="form-card">
      <columnConstraints>
        <ColumnConstraints minWidth="90"/>
        <ColumnConstraints hgrow="ALWAYS"/>
        <ColumnConstraints minWidth="90"/>
        <ColumnConstraints hgrow="ALWAYS"/>
      </columnConstraints>

      <rowConstraints>
        <RowConstraints/>
        <RowConstraints/>
      </rowConstraints>

      <children>
        <Label text="Title:"   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="titleField"  promptText="e.g. Clean Code"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Author:"  GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <TextField fx:id="authorField" promptText="e.g. Robert Martin"
                   GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <Label text="Status:"  GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ChoiceBox fx:id="statusBox"   GridPane.columnIndex="1" GridPane.rowIndex="1"/>
      </children>
    </GridPane>

    <!-- الأزرار -->
    <HBox styleClass="actions" spacing="12">
      <children>
        <Button onAction="#handleAddBook"    text="Add"/>
        <Button onAction="#handleEditBook"   text="Edit Selected"/>
        <Button onAction="#handleDeleteBook" text="Delete Selected"/>
        <Separator orientation="VERTICAL"/>
        <Button onAction="#handleBack"       text="Back"/>
      </children>
    </HBox>

  </children>

  <padding>
    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
  </padding>
</VBox>
